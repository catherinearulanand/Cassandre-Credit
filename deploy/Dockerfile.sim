FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir fastapi==0.115.* uvicorn==0.30.* pyyaml==6.*
COPY simulators/ simulators/
ENV PYTHONPATH=/app/simulators
USER 65534
EXPOSE 8090
CMD ["python", "-m", "uvicorn", "finacle_sim.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8090"]
