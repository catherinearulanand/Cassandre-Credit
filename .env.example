# Copy to .env (git-ignored) or export in your shell. Never commit real keys.
# Hosted PaddleOCR API. Synthetic data only: the service is operated outside India.
PADDLEOCR_API_URL=https://<endpoint-from-your-account-page>
PADDLEOCR_API_TOKEN=<your-key>
PADDLEOCR_AUTH_SCHEME=token
# Local PaddleOCR worker: interpreter of the isolated environment, and model profile (mobile|server)
PADDLE_PYTHON=D:/KADAISI FINAL SHIT/.venv-paddle/Scripts/python.exe
PADDLE_OCR_PROFILE=mobile

# Free-tier prototype LLM. Synthetic demonstration documents only: Groq processes data in the US.
# Create a key at https://console.groq.com/keys and keep Zero Data Retention enabled in Data Controls.
GROQ_API_KEY=<your-groq-api-key>
